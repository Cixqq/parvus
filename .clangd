CompileFlags:
  Add: [
    -xc,
    -Wall,
    -Wextra,
    -std=gnu11,
    -ffreestanding,
    -fno-stack-protector,
    -fno-stack-check,
    -fno-lto,
    -fno-PIC,
    -ffunction-sections,
    -fdata-sections,
    -m64,
    -march=x86-64,
    -mabi=sysv,
    -mno-80387,
    -mno-mmx,
    -mno-sse,
    -mno-sse2,
    -mno-red-zone,
    -mcmodel=kernel,
    -Isrc/
  ]
